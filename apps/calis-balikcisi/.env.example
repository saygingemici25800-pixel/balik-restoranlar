NEXT_PUBLIC_SITE_URL=http://localhost:3001

# CMS (Sanity — ileride)
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# SANITY_API_VERSION=
# SANITY_TOKEN=

# Database (Supabase — sadece Çalış)
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
# RESEND_API_KEY=

# Form koruma (Cloudflare Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Admin paneli (/admin) — sunucuda doğrulanır, koda yazılmaz
ADMIN_PASSWORD=

# Menü içeriği (Vercel Blob, private store: site-content.json)
# Vercel'de store projeye bağlanınca BLOB_STORE_ID + VERCEL_OIDC_TOKEN otomatik gelir.
# Lokalde hiçbiri yoksa .data/content.json kullanılır.
# BLOB_READ_WRITE_TOKEN=
